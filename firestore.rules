rules_version = '2';

// NoteWise — Firestore Security Rules (Production Readiness Phase 6).
//
// These rules ARE the authorization boundary for direct client access. The
// browser talks to Firestore directly for ordinary workspace data
// (src/lib/cloud/firestoreWorkspaceStore.js); nothing here is optional
// documentation. Model: docs/ARCHITECTURE.md → Cloud persistence.
//
// Invariants enforced:
//   - every access requires a signed-in Firebase user;
//   - a user reads/writes only their OWN users/{uid} record, and may never
//     re-point it at a workspace they are not a member of;
//   - workspace data is readable and writable ONLY by that workspace's
//     members (workspaces/{wid}/members/{uid} exists);
//   - a workspace can be created only with the caller as its owner, and
//     the owner can never be changed afterwards;
//   - a membership can be created only by a user for THEMSELVES, as owner,
//     in a workspace whose owner (after the write) is that same user — the
//     bootstrap transaction and the repair of a missing owner membership —
//     so nobody can write themselves into an existing workspace;
//   - every entity document names its own workspace and id, carries a
//     server timestamp, and cannot be moved between workspaces;
//   - nothing is ever deleted at the workspace/user/member level from the
//     client (account deletion is a later, coordinated workflow);
//   - asset metadata (workspaces/{wid}/assets, Phase 7.3) is created and
//     tombstoned by members and is NEVER deleted from the client: NoteWise
//     V1 performs no physical cloud-asset deletion (Phase 7.10A), so the
//     canonical record of an asset survives its own tombstone;
//   - Listen In TEXT results (workspaces/{wid}/listenInMeetings,
//     listenInTranscripts, listenInSummaries — Phase 8D.4) are stored under
//     their workspace but are PRIVATE TO THEIR CREATOR: each document names
//     its author in `createdBy`, only that user may read, update or delete
//     it, and the author can never be changed. Membership is still required
//     as well, so losing workspace access loses the meeting too. Every one
//     of the three carries a revision that may never go backwards, so a
//     stale replay cannot regress a newer transcript or summary; the field
//     lists are closed; and no Listen In audio has a collection here or in
//     storage.rules at all. Sharing a meeting with other members is a
//     separate, later design (Share / Inbox) that will grant access
//     explicitly — nothing here grants it by workspace membership alone.
//
// Tested against the emulator: test/rules/firestore.rules.test.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function workspacePath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid);
    }

    function memberPath(wid, uid) {
      return /databases/$(database)/documents/workspaces/$(wid)/members/$(uid);
    }

    function isMember(wid) {
      return signedIn() && exists(memberPath(wid, request.auth.uid));
    }

    function isOwner(wid) {
      return signedIn() && get(workspacePath(wid)).data.ownerUid == request.auth.uid;
    }

    function serverStamped(field) {
      return request.resource.data[field] == request.time;
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'defaultWorkspaceId', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.defaultWorkspaceId is string
        && serverStamped('createdAt')
        && serverStamped('updatedAt')
        // The pointer may only name a workspace the caller belongs to after
        // this write — the bootstrap transaction creates the membership in
        // the same transaction.
        && existsAfter(memberPath(request.resource.data.defaultWorkspaceId, uid));

      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'defaultWorkspaceId', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && serverStamped('updatedAt')
        && request.resource.data.defaultWorkspaceId is string
        && existsAfter(memberPath(request.resource.data.defaultWorkspaceId, uid));

      allow delete: if false;
    }

    // ----------------------------------------------------------- workspaces
    match /workspaces/{wid} {
      allow read: if isMember(wid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'name', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.id == wid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.schemaVersion is int
        && serverStamped('createdAt')
        && serverStamped('updatedAt');

      allow update: if isOwner(wid)
        && request.resource.data.keys().hasOnly(['id', 'name', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.id == wid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && serverStamped('updatedAt');

      allow delete: if false;

      // ----------------------------------------------------------- members
      match /members/{uid} {
        allow read: if isMember(wid);

        // Only ever one's OWN owner-membership, and only where the workspace
        // (as it stands after this write) is owned by the caller.
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'addedAt', 'addedBy'])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'owner'
          && request.resource.data.addedBy == uid
          && serverStamped('addedAt')
          && getAfter(workspacePath(wid)).data.ownerUid == request.auth.uid;

        allow update, delete: if false;
      }

      // ------------------------------------------------- entity documents
      function validEnvelope(collectionName, id) {
        return request.resource.data.workspaceId == wid
          && request.resource.data.id == id
          && request.resource.data.kind == collectionName
          && request.resource.data.schemaVersion is int
          && serverStamped('updatedAt');
      }

      function validChunkFields() {
        return !('chunked' in request.resource.data)
          || (request.resource.data.chunked == true
              && request.resource.data.chunkCount is int
              && request.resource.data.chunkCount > 0
              && request.resource.data.chunkCount <= 64);
      }

      function validChunk(collectionName, id) {
        return request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'index', 'text', 'updatedAt'])
          && request.resource.data.workspaceId == wid
          && request.resource.data.id == id
          && request.resource.data.kind == collectionName
          && request.resource.data.index is int
          && request.resource.data.text is string
          && serverStamped('updatedAt');
      }

      match /nodes/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && validEnvelope('nodes', id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'nodeKind', 'name', 'title', 'parentId', 'order'])
          // `kind` is the collection (envelope); the node's own kind is `nodeKind`.
          && request.resource.data.nodeKind in ['project', 'folder', 'note']
          && (!('name' in request.resource.data) || request.resource.data.name is string)
          && (!('title' in request.resource.data) || request.resource.data.title is string)
          && (!('parentId' in request.resource.data) || request.resource.data.parentId == null || request.resource.data.parentId is string)
          && (!('order' in request.resource.data) || request.resource.data.order is number);
        allow delete: if isMember(wid);
      }

      match /noteContent/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && validEnvelope('noteContent', id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'html', 'chunked', 'chunkCount', 'payloadUnits'])
          && (('html' in request.resource.data && request.resource.data.html is string) || request.resource.data.chunked == true)
          && validChunkFields();
        allow delete: if isMember(wid);

        match /chunks/{n} {
          allow read: if isMember(wid);
          allow create, update: if isMember(wid) && validChunk('noteContent', id);
          allow delete: if isMember(wid);
        }
      }

      match /{jsonCollection}/{id} {
        // templates, templateVersions, templateInstances, pdfDocs,
        // pdfAnnotations (Phase 7.3 seam; synced from Phase 7.7): the record
        // travels as one JSON string (or chunks of it).
        allow read: if isMember(wid)
          && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations'];
        allow create, update: if isMember(wid)
          && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations']
          && validEnvelope(jsonCollection, id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'json', 'chunked', 'chunkCount', 'payloadUnits'])
          && (('json' in request.resource.data && request.resource.data.json is string) || request.resource.data.chunked == true)
          && validChunkFields();
        allow delete: if isMember(wid)
          && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations'];

        match /chunks/{n} {
          allow read: if isMember(wid)
            && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations'];
          allow create, update: if isMember(wid)
            && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations']
            && validChunk(jsonCollection, id);
          allow delete: if isMember(wid)
            && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations'];
        }
      }

      match /notePdfRefs/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && validEnvelope('notePdfRefs', id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'pdfId'])
          && request.resource.data.pdfId is string;
        allow delete: if isMember(wid);
      }

      match /settings/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && validEnvelope('settings', id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'defaultTemplateId'])
          && (!('defaultTemplateId' in request.resource.data) || request.resource.data.defaultTemplateId is string);
        allow delete: if isMember(wid);
      }

      // --------------------------------------------- asset metadata (7.3)
      // workspaces/{wid}/assets/{assetId}: the Firestore record of an asset
      // whose BYTES live in Firebase Storage at the same path (storage.rules).
      // Field model: src/lib/cloud/assetCloudModel.js — the MIME list and the
      // caps below are that module's, asserted equal by its tests.
      //
      //   read           member
      //   create         member; state "stored", no tombstone, every field
      //                  typed and capped, identity = path, size ≤ 50 MB
      //   update         member; ONLY state / tombstonedAt / updatedAt may
      //                  change (the object is immutable, so its description
      //                  is too); stored → tombstoned stamps tombstonedAt with
      //                  the server clock; tombstoned → stored drops it;
      //                  a standing tombstone keeps its original clock
      //   delete         DENIED to everybody (Phase 7.10A). The V1 asset
      //                  lifecycle is `stored ↔ tombstoned` and nothing more:
      //                  tombstoning is reversible and the canonical record is
      //                  retained, so no client — the workspace owner
      //                  included — may destroy it. A future server-side
      //                  retention design must change this rule explicitly and
      //                  be reviewed on its own terms.
      function assetSegment(value) {
        return value.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$');
      }

      function assetMimeTypes() {
        return [
          'image/png',
          'image/jpeg',
          'image/webp',
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'text/plain',
          'text/csv',
          'application/csv'
        ];
      }

      function validAssetFields(assetId) {
        let d = request.resource.data;
        return d.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'assetKind', 'name', 'mimeType', 'size', 'createdAt', 'metadata', 'sourceAssetId', 'state', 'tombstonedAt'])
          && d.keys().hasAll(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'assetKind', 'name', 'mimeType', 'size', 'createdAt', 'metadata', 'state'])
          && d.schemaVersion == 1
          && d.assetKind in ['logo', 'note-photo', 'note-file', 'editor-image', 'editor-file', 'pdf-source']
          && (d.name == null || (d.name is string && d.name.size() <= 255))
          && d.mimeType is string
          && d.mimeType.size() <= 128
          && d.mimeType in assetMimeTypes()
          && d.size is int
          && d.size > 0
          && d.size <= 52428800
          && d.createdAt is int
          && d.createdAt > 0
          && d.metadata is map
          && d.metadata.size() <= 64
          && (!('sourceAssetId' in d) || (d.sourceAssetId is string && assetSegment(d.sourceAssetId) && d.sourceAssetId != assetId))
          && d.state in ['stored', 'tombstoned'];
      }

      function validAssetStateChange() {
        let next = request.resource.data;
        let prev = resource.data;
        return (next.state == 'stored' && !('tombstonedAt' in next))
          || (next.state == 'tombstoned' && prev.state == 'tombstoned' && next.tombstonedAt == prev.tombstonedAt)
          || (next.state == 'tombstoned' && prev.state != 'tombstoned' && next.tombstonedAt == request.time);
      }

      match /assets/{assetId} {
        allow read: if isMember(wid);
        allow create: if isMember(wid)
          && assetSegment(assetId)
          && validEnvelope('assets', assetId)
          && validAssetFields(assetId)
          && request.resource.data.state == 'stored'
          && !('tombstonedAt' in request.resource.data);
        allow update: if isMember(wid)
          && validEnvelope('assets', assetId)
          && validAssetFields(assetId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'tombstonedAt', 'updatedAt'])
          && validAssetStateChange();
        allow delete: if false;
      }

      // ------------------------------------------- Listen In (Phase 8D.4)
      // Text results of a Listen In MEETING: never audio. Model:
      // src/lib/cloud/listenInCloudModel.js — the field lists, enums and caps
      // below are that module's, asserted equal by its tests.
      //
      //   listenInMeetings/{sessionId}            header (native fields)
      //   listenInTranscripts/{sessionId}:{page}  one page of ordered segments
      //                                           (json / chunks + hoisted
      //                                           sessionId, createdBy, page,
      //                                           revision)
      //   listenInSummaries/{sessionId}           structured summary (json /
      //                                           chunks + hoisted sessionId,
      //                                           createdBy, revision)
      //
      // CREATOR-ONLY, by product decision (V1): a meeting belongs to the
      // person who recorded it, not to everyone who shares their workspace.
      //
      //   read           member AND `resource.data.createdBy == uid`. A list
      //                  query must therefore constrain on createdBy, which
      //                  is what the client's reads do.
      //   create         member; closed field list; typed and capped;
      //                  identity = path; `createdBy` == the caller
      //   update         member; creator; same validation; createdBy
      //                  unchanged; revision >= the stored revision (an equal
      //                  revision is the idempotent replay of an accepted
      //                  write)
      //   delete         member; creator (a discard removes the meeting's
      //                  records — the JSON-entity policy, unlike assets).
      //                  A document that is ABSENT is deletable as a no-op:
      //                  `resource` is null then, so the creator test cannot
      //                  run, and a discard of a meeting that never reached
      //                  the account must not leave a permanently failing
      //                  outbox entry behind.
      //
      // The chunk sub-collections hold pieces of the SAME text, so they are
      // gated on their parent's author rather than on membership: `get` for
      // a read or a delete (the parent is still there), `getAfter` for a
      // write, so the first chunked create — parent and chunks in one batch —
      // is judged on the state the batch produces.
      function nullOrInt(v) {
        return v == null || v is int;
      }

      function nullOrText(v, max) {
        return v == null || (v is string && v.size() <= max);
      }

      function listenInCreator() {
        return resource != null && resource.data.createdBy == request.auth.uid;
      }

      function revisionHolds() {
        return request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && (resource == null || request.resource.data.revision >= resource.data.revision);
      }

      function validListenInMeeting(sessionId) {
        let d = request.resource.data;
        return d.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt',
            'sessionId', 'createdBy', 'title', 'language', 'startedAt', 'stoppedAt', 'completedAt',
            'capturedMs', 'legStartedAt', 'state', 'stopReason', 'limitWarnedAt', 'source', 'captureSource',
            'platform', 'noteId', 'projectId', 'folderId', 'revision', 'segmentCount', 'transcribedThroughSeq',
            'pendingCount', 'failedSeqs', 'transcriptPageCount', 'transcriptPageSize', 'summaryRevision',
            'summaryStatus', 'summaryFinal', 'summaryCoveredThroughSeq'])
          && d.keys().hasAll(['sessionId', 'createdBy', 'title', 'language', 'startedAt', 'capturedMs', 'state',
            'revision', 'segmentCount', 'transcribedThroughSeq', 'pendingCount', 'failedSeqs',
            'transcriptPageCount', 'transcriptPageSize', 'summaryRevision', 'summaryFinal',
            'summaryCoveredThroughSeq'])
          && d.sessionId == sessionId
          && d.createdBy is string
          && d.title is string && d.title.size() <= 200
          && d.language is string && d.language.size() <= 16
          && d.startedAt is int && d.startedAt > 0
          && nullOrInt(d.get('stoppedAt', null))
          && nullOrInt(d.get('completedAt', null))
          && d.capturedMs is int && d.capturedMs >= 0
          && nullOrInt(d.get('legStartedAt', null))
          && d.state in ['recording', 'paused', 'stopping', 'finishing', 'finished', 'interrupted']
          && (d.get('stopReason', null) == null || d.stopReason in ['user', 'error', 'interruption', 'limit'])
          && nullOrInt(d.get('limitWarnedAt', null))
          && nullOrText(d.get('source', null), 64)
          && nullOrText(d.get('captureSource', null), 64)
          && nullOrText(d.get('platform', null), 64)
          && nullOrText(d.get('noteId', null), 200)
          && nullOrText(d.get('projectId', null), 200)
          && nullOrText(d.get('folderId', null), 200)
          && d.segmentCount is int && d.segmentCount >= 0
          && d.transcribedThroughSeq is int && d.transcribedThroughSeq >= -1
          && d.pendingCount is int && d.pendingCount >= 0
          && d.failedSeqs is list && d.failedSeqs.size() <= 1024
          && d.transcriptPageCount is int && d.transcriptPageCount >= 0
          && d.transcriptPageSize is int && d.transcriptPageSize >= 1
          && d.summaryRevision is int && d.summaryRevision >= 0
          && (d.get('summaryStatus', null) == null || d.summaryStatus in ['idle', 'ready', 'failed'])
          && d.summaryFinal is bool
          && d.summaryCoveredThroughSeq is int && d.summaryCoveredThroughSeq >= -1;
      }

      match /listenInMeetings/{sessionId} {
        allow read: if isMember(wid) && listenInCreator();
        allow create: if isMember(wid)
          && validEnvelope('listenInMeetings', sessionId)
          && validListenInMeeting(sessionId)
          && revisionHolds()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(wid)
          && listenInCreator()
          && validEnvelope('listenInMeetings', sessionId)
          && validListenInMeeting(sessionId)
          && revisionHolds()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(wid) && (resource == null || listenInCreator());
      }

      function validListenInJson(keys) {
        return request.resource.data.keys().hasOnly(keys)
          && (('json' in request.resource.data && request.resource.data.json is string) || request.resource.data.chunked == true)
          && validChunkFields()
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() > 0
          && request.resource.data.createdBy is string
          && (resource == null || request.resource.data.sessionId == resource.data.sessionId);
      }

      match /listenInTranscripts/{id} {
        allow read: if isMember(wid) && listenInCreator();
        allow create: if isMember(wid)
          && validEnvelope('listenInTranscripts', id)
          && validListenInJson(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'json', 'chunked', 'chunkCount', 'payloadUnits', 'sessionId', 'createdBy', 'page', 'revision'])
          && request.resource.data.page is int
          && request.resource.data.page >= 0
          && id == request.resource.data.sessionId + ':' + string(request.resource.data.page)
          && revisionHolds()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(wid)
          && listenInCreator()
          && validEnvelope('listenInTranscripts', id)
          && validListenInJson(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'json', 'chunked', 'chunkCount', 'payloadUnits', 'sessionId', 'createdBy', 'page', 'revision'])
          && request.resource.data.page is int
          && request.resource.data.page >= 0
          && id == request.resource.data.sessionId + ':' + string(request.resource.data.page)
          && revisionHolds()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(wid) && (resource == null || listenInCreator());

        match /chunks/{n} {
          allow read: if isMember(wid)
            && get(/databases/$(database)/documents/workspaces/$(wid)/listenInTranscripts/$(id)).data.createdBy == request.auth.uid;
          allow create, update: if isMember(wid)
            && validChunk('listenInTranscripts', id)
            && getAfter(/databases/$(database)/documents/workspaces/$(wid)/listenInTranscripts/$(id)).data.createdBy == request.auth.uid;
          allow delete: if isMember(wid)
            && (!exists(/databases/$(database)/documents/workspaces/$(wid)/listenInTranscripts/$(id))
                || get(/databases/$(database)/documents/workspaces/$(wid)/listenInTranscripts/$(id)).data.createdBy == request.auth.uid);
        }
      }

      match /listenInSummaries/{sessionId} {
        allow read: if isMember(wid) && listenInCreator();
        allow create: if isMember(wid)
          && validEnvelope('listenInSummaries', sessionId)
          && validListenInJson(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'json', 'chunked', 'chunkCount', 'payloadUnits', 'sessionId', 'createdBy', 'revision'])
          && request.resource.data.sessionId == sessionId
          && revisionHolds()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(wid)
          && listenInCreator()
          && validEnvelope('listenInSummaries', sessionId)
          && validListenInJson(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'json', 'chunked', 'chunkCount', 'payloadUnits', 'sessionId', 'createdBy', 'revision'])
          && request.resource.data.sessionId == sessionId
          && revisionHolds()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(wid) && (resource == null || listenInCreator());

        match /chunks/{n} {
          allow read: if isMember(wid)
            && get(/databases/$(database)/documents/workspaces/$(wid)/listenInSummaries/$(sessionId)).data.createdBy == request.auth.uid;
          allow create, update: if isMember(wid)
            && validChunk('listenInSummaries', sessionId)
            && getAfter(/databases/$(database)/documents/workspaces/$(wid)/listenInSummaries/$(sessionId)).data.createdBy == request.auth.uid;
          allow delete: if isMember(wid)
            && (!exists(/databases/$(database)/documents/workspaces/$(wid)/listenInSummaries/$(sessionId))
                || get(/databases/$(database)/documents/workspaces/$(wid)/listenInSummaries/$(sessionId)).data.createdBy == request.auth.uid);
        }
      }

      match /migrations/{sourceId} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && request.resource.data.workspaceId == wid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.sourceId == sourceId
          && serverStamped('updatedAt');
        allow delete: if false;
      }
    }
  }
}
