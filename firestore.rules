rules_version = '2';

// NoteWise — Firestore Security Rules (Production Readiness Phase 6).
//
// These rules ARE the authorization boundary for direct client access. The
// browser talks to Firestore directly for ordinary workspace data
// (src/lib/cloud/firestoreWorkspaceStore.js); nothing here is optional
// documentation. Model: docs/ARCHITECTURE.md → Cloud persistence.
//
// Invariants enforced:
//   - every access requires a signed-in Firebase user;
//   - a user reads/writes only their OWN users/{uid} record, and may never
//     re-point it at a workspace they are not a member of;
//   - workspace data is readable and writable ONLY by that workspace's
//     members (workspaces/{wid}/members/{uid} exists);
//   - a workspace can be created only with the caller as its owner, and
//     the owner can never be changed afterwards;
//   - a membership can be created only by a user for THEMSELVES, as owner,
//     in a workspace whose owner (after the write) is that same user — the
//     bootstrap transaction and the repair of a missing owner membership —
//     so nobody can write themselves into an existing workspace;
//   - every entity document names its own workspace and id, carries a
//     server timestamp, and cannot be moved between workspaces;
//   - nothing is ever deleted at the workspace/user/member level from the
//     client (account deletion is a later, coordinated workflow);
//   - asset metadata (workspaces/{wid}/assets, Phase 7.3) is created and
//     tombstoned by members but DELETED only by the workspace owner.
//
// Tested against the emulator: test/rules/firestore.rules.test.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function workspacePath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid);
    }

    function memberPath(wid, uid) {
      return /databases/$(database)/documents/workspaces/$(wid)/members/$(uid);
    }

    function isMember(wid) {
      return signedIn() && exists(memberPath(wid, request.auth.uid));
    }

    function isOwner(wid) {
      return signedIn() && get(workspacePath(wid)).data.ownerUid == request.auth.uid;
    }

    function serverStamped(field) {
      return request.resource.data[field] == request.time;
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'defaultWorkspaceId', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.defaultWorkspaceId is string
        && serverStamped('createdAt')
        && serverStamped('updatedAt')
        // The pointer may only name a workspace the caller belongs to after
        // this write — the bootstrap transaction creates the membership in
        // the same transaction.
        && existsAfter(memberPath(request.resource.data.defaultWorkspaceId, uid));

      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'defaultWorkspaceId', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && serverStamped('updatedAt')
        && request.resource.data.defaultWorkspaceId is string
        && existsAfter(memberPath(request.resource.data.defaultWorkspaceId, uid));

      allow delete: if false;
    }

    // ----------------------------------------------------------- workspaces
    match /workspaces/{wid} {
      allow read: if isMember(wid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'name', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.id == wid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.schemaVersion is int
        && serverStamped('createdAt')
        && serverStamped('updatedAt');

      allow update: if isOwner(wid)
        && request.resource.data.keys().hasOnly(['id', 'name', 'ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.id == wid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && serverStamped('updatedAt');

      allow delete: if false;

      // ----------------------------------------------------------- members
      match /members/{uid} {
        allow read: if isMember(wid);

        // Only ever one's OWN owner-membership, and only where the workspace
        // (as it stands after this write) is owned by the caller.
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'addedAt', 'addedBy'])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'owner'
          && request.resource.data.addedBy == uid
          && serverStamped('addedAt')
          && getAfter(workspacePath(wid)).data.ownerUid == request.auth.uid;

        allow update, delete: if false;
      }

      // ------------------------------------------------- entity documents
      function validEnvelope(collectionName, id) {
        return request.resource.data.workspaceId == wid
          && request.resource.data.id == id
          && request.resource.data.kind == collectionName
          && request.resource.data.schemaVersion is int
          && serverStamped('updatedAt');
      }

      function validChunkFields() {
        return !('chunked' in request.resource.data)
          || (request.resource.data.chunked == true
              && request.resource.data.chunkCount is int
              && request.resource.data.chunkCount > 0
              && request.resource.data.chunkCount <= 64);
      }

      function validChunk(collectionName, id) {
        return request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'index', 'text', 'updatedAt'])
          && request.resource.data.workspaceId == wid
          && request.resource.data.id == id
          && request.resource.data.kind == collectionName
          && request.resource.data.index is int
          && request.resource.data.text is string
          && serverStamped('updatedAt');
      }

      match /nodes/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && validEnvelope('nodes', id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'nodeKind', 'name', 'title', 'parentId', 'order'])
          // `kind` is the collection (envelope); the node's own kind is `nodeKind`.
          && request.resource.data.nodeKind in ['project', 'folder', 'note']
          && (!('name' in request.resource.data) || request.resource.data.name is string)
          && (!('title' in request.resource.data) || request.resource.data.title is string)
          && (!('parentId' in request.resource.data) || request.resource.data.parentId == null || request.resource.data.parentId is string)
          && (!('order' in request.resource.data) || request.resource.data.order is number);
        allow delete: if isMember(wid);
      }

      match /noteContent/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && validEnvelope('noteContent', id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'html', 'chunked', 'chunkCount', 'payloadUnits'])
          && (('html' in request.resource.data && request.resource.data.html is string) || request.resource.data.chunked == true)
          && validChunkFields();
        allow delete: if isMember(wid);

        match /chunks/{n} {
          allow read: if isMember(wid);
          allow create, update: if isMember(wid) && validChunk('noteContent', id);
          allow delete: if isMember(wid);
        }
      }

      match /{jsonCollection}/{id} {
        // templates, templateVersions, templateInstances, pdfDocs,
        // pdfAnnotations (Phase 7.3 seam; synced from Phase 7.7): the record
        // travels as one JSON string (or chunks of it).
        allow read: if isMember(wid)
          && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations'];
        allow create, update: if isMember(wid)
          && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations']
          && validEnvelope(jsonCollection, id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'json', 'chunked', 'chunkCount', 'payloadUnits'])
          && (('json' in request.resource.data && request.resource.data.json is string) || request.resource.data.chunked == true)
          && validChunkFields();
        allow delete: if isMember(wid)
          && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations'];

        match /chunks/{n} {
          allow read: if isMember(wid)
            && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations'];
          allow create, update: if isMember(wid)
            && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations']
            && validChunk(jsonCollection, id);
          allow delete: if isMember(wid)
            && jsonCollection in ['templates', 'templateVersions', 'templateInstances', 'pdfDocs', 'pdfAnnotations'];
        }
      }

      match /notePdfRefs/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && validEnvelope('notePdfRefs', id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'pdfId'])
          && request.resource.data.pdfId is string;
        allow delete: if isMember(wid);
      }

      match /settings/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && validEnvelope('settings', id)
          && request.resource.data.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'defaultTemplateId'])
          && (!('defaultTemplateId' in request.resource.data) || request.resource.data.defaultTemplateId is string);
        allow delete: if isMember(wid);
      }

      // --------------------------------------------- asset metadata (7.3)
      // workspaces/{wid}/assets/{assetId}: the Firestore record of an asset
      // whose BYTES live in Firebase Storage at the same path (storage.rules).
      // Field model: src/lib/cloud/assetCloudModel.js — the MIME list and the
      // caps below are that module's, asserted equal by its tests.
      //
      //   read           member
      //   create         member; state "stored", no tombstone, every field
      //                  typed and capped, identity = path, size ≤ 50 MB
      //   update         member; ONLY state / tombstonedAt / updatedAt may
      //                  change (the object is immutable, so its description
      //                  is too); stored → tombstoned stamps tombstonedAt with
      //                  the server clock; tombstoned → stored drops it;
      //                  a standing tombstone keeps its original clock
      //   delete         the workspace OWNER only (destructive cloud GC is
      //                  owner-authorised — workspaces/{wid}.ownerUid)
      function assetSegment(value) {
        return value.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$');
      }

      function assetMimeTypes() {
        return [
          'image/png',
          'image/jpeg',
          'image/webp',
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'text/plain',
          'text/csv',
          'application/csv'
        ];
      }

      function validAssetFields(assetId) {
        let d = request.resource.data;
        return d.keys().hasOnly(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'assetKind', 'name', 'mimeType', 'size', 'createdAt', 'metadata', 'sourceAssetId', 'state', 'tombstonedAt'])
          && d.keys().hasAll(['workspaceId', 'id', 'kind', 'schemaVersion', 'updatedAt', 'assetKind', 'name', 'mimeType', 'size', 'createdAt', 'metadata', 'state'])
          && d.schemaVersion == 1
          && d.assetKind in ['logo', 'note-photo', 'note-file', 'editor-image', 'editor-file', 'pdf-source']
          && (d.name == null || (d.name is string && d.name.size() <= 255))
          && d.mimeType is string
          && d.mimeType.size() <= 128
          && d.mimeType in assetMimeTypes()
          && d.size is int
          && d.size > 0
          && d.size <= 52428800
          && d.createdAt is int
          && d.createdAt > 0
          && d.metadata is map
          && d.metadata.size() <= 64
          && (!('sourceAssetId' in d) || (d.sourceAssetId is string && assetSegment(d.sourceAssetId) && d.sourceAssetId != assetId))
          && d.state in ['stored', 'tombstoned'];
      }

      function validAssetStateChange() {
        let next = request.resource.data;
        let prev = resource.data;
        return (next.state == 'stored' && !('tombstonedAt' in next))
          || (next.state == 'tombstoned' && prev.state == 'tombstoned' && next.tombstonedAt == prev.tombstonedAt)
          || (next.state == 'tombstoned' && prev.state != 'tombstoned' && next.tombstonedAt == request.time);
      }

      match /assets/{assetId} {
        allow read: if isMember(wid);
        allow create: if isMember(wid)
          && assetSegment(assetId)
          && validEnvelope('assets', assetId)
          && validAssetFields(assetId)
          && request.resource.data.state == 'stored'
          && !('tombstonedAt' in request.resource.data);
        allow update: if isMember(wid)
          && validEnvelope('assets', assetId)
          && validAssetFields(assetId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'tombstonedAt', 'updatedAt'])
          && validAssetStateChange();
        allow delete: if isOwner(wid);
      }

      match /migrations/{sourceId} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid)
          && request.resource.data.workspaceId == wid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.sourceId == sourceId
          && serverStamped('updatedAt');
        allow delete: if false;
      }
    }
  }
}
